# Copy to .env and fill in only what you need. Defaults are offline mocks (no keys required).

# --- Provider selection ---
OMNI_STT=mock          # mock | yandex
OMNI_EMBED=mock        # mock | openai | local
OMNI_LLM=mock          # mock | anthropic | openai
OMNI_STORE=memory      # memory | pgvector
OMNI_DIARIZER=off      # off | mock | pyannote   (segment speaker turns + voiceprints)

# --- Tuning ---
# Sizes the mock vector AND the OpenAI-compatible vector. Must match the model:
#   text-embedding-3-small=1536, BGE-M3 served via TEI=1024, multilingual-e5-large=1024.
# The "local" provider ignores this and reports its model's actual dim.
OMNI_EMBED_DIM=256
OMNI_DEFAULT_LANG=ru
OMNI_TOP_K=5

# --- Local embeddings (when OMNI_EMBED=local) — in-country, no cross-border path ---
# Default: BGE-M3 (multilingual, 1024-dim, strong on RU/UZ). Alternatives without code
# changes: intfloat/multilingual-e5-large (1024-dim), intfloat/multilingual-e5-base (768).
# Requires `pip install sentence-transformers` (kept out of the base requirements so the
# offline demo stays light).
OMNI_LOCAL_EMBED_MODEL=BAAI/bge-m3
OMNI_LOCAL_EMBED_DEVICE=cpu   # cpu | cuda | mps

# --- Diarization (when OMNI_DIARIZER=pyannote) — in-country, voiceprints stay local ---
# Requires:  pip install pyannote.audio>=3.1 torchaudio soundfile
# + HF_TOKEN with access to pyannote/speaker-diarization-3.1 and pyannote/embedding
#   (both are gated — accept the license on HuggingFace once per account).
HF_TOKEN=
OMNI_DIARIZER_DEVICE=cpu      # cpu | cuda

# --- Owner-voice enrollment (single centroid voiceprint, in-country) ---
# Empty path = in-memory only. Set to e.g. ./data/owner.json to persist across restarts.
OMNI_OWNER_VOICEPRINT_PATH=
OMNI_OWNER_THRESHOLD=0.7      # cosine score above which a diarized speaker is "owner"

# --- Per-tenant consent log (append-only audit trail for ZRU-547) ---
# Empty path = in-memory only. Set to e.g. ./data/consent.json — one file per tenant
# is created on the side (consent.<tenant>.json).
OMNI_CONSENT_LOG_PATH=

# --- Billing provider (mock for Phase 0; payme/click stubs ship now) ---
# Real Payme/Click adapters land with the merchant contract. Setting OMNI_BILLING=payme
# without filling in the adapter raises a clear NotImplementedError at startup.
OMNI_BILLING=mock          # mock | payme | click

# --- Per-tenant rate limiting (token bucket) ---
# Sustained rate (requests/minute) and burst capacity. /health and DELETE /data are
# intentionally exempt. Tune per environment; Phase 1 backs this with Redis.
OMNI_RATE_PER_MIN=60
OMNI_RATE_BURST=10

# --- Encryption at rest (segment text + future voiceprints) ---
# mock = passthrough (default; keeps offline demo + tests unchanged).
# fernet = real AEAD via cryptography.fernet. Per-tenant DEK derived from KEK via
# HKDF-SHA256, so restarts do NOT lose access (the KEK is the only persisted secret).
# Generate a KEK with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Production: read from Vault / KMS, never from .env. See docs/data-residency.md.
OMNI_ENCRYPTION=mock        # mock | fernet
OMNI_KEK=

# --- Knowledge-graph memory (entities + relations + temporal markers) ---
# off (default; keeps offline demo + tests unchanged).
# mock = rule-based extraction over RU/UZ/EN meeting patterns, in-memory.
# graphiti = Graphiti adapter STUB (needs Neo4j); raises on construction.
# mem0     = Mem0 adapter STUB; raises on construction.
OMNI_KG=off                 # off | mock | graphiti | mem0

# --- Yandex SpeechKit (when OMNI_STT=yandex) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Anthropic / Claude (when OMNI_LLM=anthropic) — answers + briefings ---
ANTHROPIC_API_KEY=
OMNI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI-compatible LLM/embeddings (when OMNI_LLM=openai / OMNI_EMBED=openai) ---
# NOTE: this is a cross-border TEXT path — only with user consent; voice stays in-country.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OMNI_CHAT_MODEL=gpt-4o-mini
OMNI_EMBED_MODEL=text-embedding-3-small

# --- Postgres + pgvector (when OMNI_STORE=pgvector) ---
DATABASE_URL=postgresql://omni:omni@localhost:5432/omni
